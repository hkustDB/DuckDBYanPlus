# name: test/sql/optimizer/yanplus_aggregation_v15.test
# description: Yan+ aggregation pushdown preserves DuckDB v1.5 types and join multiplicities
# group: [optimizer]

require yanplus

statement ok
CREATE TABLE yan_agg_a(id INTEGER, x INTEGER)

statement ok
CREATE TABLE yan_agg_b(id INTEGER, y INTEGER)

statement ok
CREATE TABLE yan_agg_c(id INTEGER, z INTEGER)

statement ok
INSERT INTO yan_agg_a VALUES (1, 10), (1, 20), (2, 30)

statement ok
INSERT INTO yan_agg_b VALUES (1, 100), (1, 200), (2, 300)

statement ok
INSERT INTO yan_agg_c VALUES (1, 1000), (2, 2000), (2, 3000)

# These single-family aggregates exercise the Yan+ aggregate rewrite.
query I
SELECT count(*)
FROM yan_agg_a a JOIN yan_agg_b b USING (id) JOIN yan_agg_c c USING (id)
----
6

query I
SELECT sum(x)
FROM yan_agg_a a JOIN yan_agg_b b USING (id) JOIN yan_agg_c c USING (id)
----
120

query I
SELECT min(x)
FROM yan_agg_a a JOIN yan_agg_b b USING (id) JOIN yan_agg_c c USING (id)
----
10

query I
SELECT max(x)
FROM yan_agg_a a JOIN yan_agg_b b USING (id) JOIN yan_agg_c c USING (id)
----
30

# Rewriting COUNT(*) as SUM(annotation) must preserve COUNT's empty-input
# value and BIGINT result type.
statement ok
CREATE TABLE yan_agg_empty(id INTEGER)

query I
SELECT count(*)
FROM yan_agg_a a JOIN yan_agg_empty e USING (id)
----
0

query T
SELECT typeof(count(*))
FROM yan_agg_a a JOIN yan_agg_b b USING (id)
----
BIGINT

# Multiple/mixed aggregates and GROUP BY are intentionally left to native v1.5.
query III
SELECT count(*), sum(x), min(x)
FROM yan_agg_a a JOIN yan_agg_b b USING (id) JOIN yan_agg_c c USING (id)
----
6	120	10

query II rowsort
SELECT id, count(*)
FROM yan_agg_a a JOIN yan_agg_b b USING (id) JOIN yan_agg_c c USING (id)
GROUP BY id
----
1	4
2	2

# Cyclic plans place CREATE_BF/USE_BF between the aggregate rewrite and the
# original joins. Both wrappers are transparent for column-name resolution.
statement ok
CREATE TABLE yan_cycle_a(x INTEGER, y INTEGER)

statement ok
CREATE TABLE yan_cycle_b(y INTEGER, z INTEGER)

statement ok
CREATE TABLE yan_cycle_c(z INTEGER, x INTEGER)

statement ok
INSERT INTO yan_cycle_a VALUES (1, 10), (1, 10), (2, 20), (3, NULL)

statement ok
INSERT INTO yan_cycle_b VALUES (10, 100), (20, 200), (NULL, 300)

statement ok
INSERT INTO yan_cycle_c VALUES (100, 1), (200, 2), (100, 9)

statement ok
SET yanplus_semijoin_filter = 'bloom'

query I
SELECT sum(a.x)
FROM yan_cycle_a a
JOIN yan_cycle_b b ON a.y = b.y
JOIN yan_cycle_c c ON b.z = c.z AND a.x = c.x
----
4

query II
EXPLAIN SELECT sum(a.x)
FROM yan_cycle_a a
JOIN yan_cycle_b b ON a.y = b.y
JOIN yan_cycle_c c ON b.z = c.z AND a.x = c.x
----
physical_plan	<REGEX>:.*(USE_BF.*CREATE_BF|CREATE_BF.*USE_BF).*

statement ok
SET yanplus_semijoin_filter = 'hash'

query I
SELECT sum(a.x)
FROM yan_cycle_a a
JOIN yan_cycle_b b ON a.y = b.y
JOIN yan_cycle_c c ON b.z = c.z AND a.x = c.x
----
4

statement ok
SET yanplus_semijoin_filter = 'bloom'
